# .env.example — Copiá a ".env" y completá los valores.
#   cp .env.example .env
# Nunca subas .env al repositorio: tiene secretos.

# Clave para firmar las cookies de sesión (obligatoria).
# Generá una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=489d79d179ee2018e73368b0302a2c4b33b2f09f9f0627d4de7ebf47b6bc5dc5

# Base de datos MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cdhi
MYSQL_PASSWORD=una-contraseña-fuerte
MYSQL_DB=cdhi

# Puerto del servidor de desarrollo (solo "python app.py")
PORT=5000

# Cookies solo sobre HTTPS; usar 1 en producción y 0 en desarrollo local.
SESSION_COOKIE_SECURE=0
